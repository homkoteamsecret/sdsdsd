{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/me", "destination": "/me.html" }
  ],
  "headers": [
    {
      "source": "/(.*).mp3",
      "headers": [
        { "key": "Content-Type", "value": "audio/mpeg" }
      ]
    },
    {
      "source": "/(.*).png",
      "headers": [
        { "key": "Content-Type", "value": "image/png" }
      ]
    },
    {
      "source": "/(.*).gif",
      "headers": [
        { "key": "Content-Type", "value": "image/gif" }
      ]
    },
    {
      "source": "/(.*).json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}